# Lidar and DEM directories (too large for git; 7+ GB)
ne_wa_ree/data/lidar/
ne_wa_ree/data/dem/
ne_wa_ree/data/aster_emit/
data/dem/

# PAD-US / MLRS / AIANNH land-access caches (python -m pipeline.fetch_land_access)
data/padus/
data/mlrs/
data/aiannh/

# Census county boundaries (python -m pipeline.fetch_region)
data/counties/

# SGMC state extracts (re-download from mrdata.usgs.gov)
data/geologic/

# Hydraulic-pit and USMIN zip/shapefile caches (derived geojson is kept)
data/placer_layers/raw/

# Historical topo PDFs (re-download from USGS TopoView)
ne_wa_ree/data/lidar/*.pdf

# WGS OFR 2026-02 supplement (public document; see DATA_SOURCES.md)
data/wgs_ofr2026/

# National NAMRAD zip cache used only to clip study-area GeoTIFFs
data/radiometric/raw/

# National NURE HSSR zip (clipped extracts in data/nure/*.csv are kept)
data/nure/raw/

# Regenerable Task 11 caches (rebuild with --tasks 11 / --gpkg-only)
**/outputs/geojson/task11_dem_streams.geojson
**/outputs/geojson/task11_field_campaign.gpkg
ne_wa_ree/data/geologic/WA.zip

